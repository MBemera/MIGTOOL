{
  "name": "migtool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/dev.ts --demo",
    "build": "npm run generate:schema && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx packages/server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:config": "node --import tsx scripts/check-config.ts",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --import tsx packages/worker/index.ts",
    "generate:schema": "node --import tsx scripts/generate-schema.ts",
    "format": "prettier --write packages scripts tests migrations docs *.ts *.json *.md",
    "revalidate": "node --env-file-if-exists=.env --import tsx scripts/revalidate.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "csv:control": "node --import tsx scripts/csv-control.ts",
    "import:csv": "node --env-file-if-exists=.env --import tsx scripts/import-csv.ts",
    "export:batch": "node --env-file-if-exists=.env --import tsx scripts/export-batch.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "json-logic-js": "2.0.5",
    "jsonata": "1.8.9",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.5",
    "@types/json-logic-js": "2.0.8",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
