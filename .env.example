HOST=127.0.0.1
PORT=3001
DATABASE_PATH=var/migtool.sqlite
MIGTOOL_ADMIN_USER=admin
MIGTOOL_ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=http://127.0.0.1:3001
# Bank 2 CBS load folder and Bank 1 extract landing folder; both may be OneDrive folders.
# CBS_OUTBOX=C:\Users\you\OneDrive - Bank 2\Migration\CBS Load
# EXTRACT_LANDING=C:\Users\you\OneDrive - Bank 2\Migration\Landing
CBS_OUTBOX=var/cbs-outbox
# Local staging on the same drive as CBS_OUTBOX, never in OneDrive. Defaults to var/staging.
# CBS_STAGING=C:\MigtoolData\staging
# Set NODE_ENV=production behind HTTPS; HTTPS proxy must preserve Origin.
# LIVE bank delivery and external LLM endpoints are intentionally not implemented.
